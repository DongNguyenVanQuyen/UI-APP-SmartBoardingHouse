<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingTop="40dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Chụp công tơ điện/nước"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Chỉ số kỳ trước (load từ API) -->
            <TextView
                android:id="@+id/tvPreviousReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_card"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:text="Đang tải chỉ số kỳ trước..."
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Banner cảnh báo đã gửi tháng này (ẩn mặc định) -->
            <LinearLayout
                android:id="@+id/layoutAlreadySubmitted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_warning_card"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvAlreadySubmitted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/warning_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Loại công tơ: Điện / Nước — đặt NGOÀI layoutCamera và layoutManual để luôn hiển thị
                 ở cả 2 màn (trước đây nằm trong layoutManual nên lúc đang ở màn Camera không chọn được,
                 khiến app luôn ngầm định "Điện" khi tải chỉ số kỳ trước và khi chụp/scan). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Loại công tơ"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp" />

            <!-- CAMERA STATE (mặc định visible) -->
            <LinearLayout
                android:id="@+id/layoutCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:visibility="visible">

                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:background="#000000" />

                <ImageView
                    android:id="@+id/ivCaptured"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Kết quả Gemini đọc -->
                <TextView
                    android:id="@+id/tvOcrResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Hướng camera vào màn số công tơ rồi bấm Chụp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCapture"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/gradient_button"
                        android:text="Chụp"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnPickImage"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:text="Chọn ảnh"
                        android:textSize="13sp"
                        style="@style/Widget.SmartBoarding.Button.Outlined" />

                    <Button
                        android:id="@+id/btnManual"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Nhập tay"
                        android:textSize="13sp"
                        style="@style/Widget.SmartBoarding.Button.Outlined" />
                </LinearLayout>
            </LinearLayout>

            <!-- FORM NHẬP CHỈ SỐ (mặc định GONE, hiện sau khi chụp/bấm nhập tay) -->
            <LinearLayout
                android:id="@+id/layoutManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Ảnh đã chụp (hiện lại trong form nhập) -->
                        <ImageView
                            android:id="@+id/ivCapturedInForm"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginBottom="12dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <!-- Kết quả Gemini (hiện trong form nhập) -->
                        <TextView
                            android:id="@+id/tvOcrResultForm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:padding="8dp"
                            android:background="@drawable/bg_info_card"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <!-- Chỉ số hiện tại — tự điền từ Gemini, người dùng kiểm tra/sửa -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:hint="Chỉ số hiện tại (kWh / m³)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCurrentReading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Gợi ý: kiểm tra lại số Gemini đọc -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="⚠ Kiểm tra lại số trên công tơ và chỉnh sửa nếu Gemini đọc sai"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Nút chụp lại -->
                        <Button
                            android:id="@+id/btnRetake"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_gravity="end"
                            android:text="📷 Chụp lại"
                            android:textSize="12sp"
                            style="@style/Widget.SmartBoarding.Button.Outlined"
                            android:onClick="onRetakeClicked" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- SUBMIT BUTTON -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/gradient_button"
        android:text="Lưu chỉ số"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>