<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header gradient với tên + phòng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_header"
                android:orientation="vertical"
                android:padding="24dp"
                android:paddingTop="48dp"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xin chào,"
                            android:textColor="#CCffffff"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tvTenantName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang tải..."
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:civ_border_color="@color/white"
                        app:civ_border_width="2dp"/>
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#33FFFFFF"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Phòng của bạn"
                                android:textColor="#CCffffff"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/tvRoomNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/white"
                                android:textSize="28sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvFloor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="#CCffffff"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <!-- Chỉ hiện khi tenant đang thuê từ 2 phòng trở lên
                             (rooms.size > 1 / hasMultipleRooms = true) -->
                        <TextView
                            android:id="@+id/btnSwitchRoom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:background="@drawable/bg_badge_unpaid"
                            android:text="Chọn phòng"
                            android:textColor="@color/blue_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone"/>

                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:iiv_icon="gmd_home"
                            app:iiv_color="@color/white"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Hóa đơn tháng này -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hóa đơn tháng này"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tvInvoiceStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chưa thanh toán"
                            android:textSize="12sp"
                            android:textColor="@color/badge_unpaid_text"
                            android:background="@drawable/bg_badge_unpaid"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 đ"
                        android:textColor="@color/purple_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout android:id="@+id/layoutInvoiceItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginVertical="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/btnInvoiceDetail"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Chi tiết"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.SmartBoarding.Button.Outlined"/>

                        <Button
                            android:id="@+id/btnPayNow"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Thanh toán"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/gradient_button"
                            android:textColor="@color/white"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stats grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:background="@drawable/bg_icon_blue"
                            app:iiv_icon="gmd_payments"
                            app:iiv_color="@color/icon_blue"
                            android:layout_marginBottom="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tiền phòng" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvRentAmount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textColor="@color/text_primary"
                            android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:background="@drawable/bg_icon_yellow"
                            app:iiv_icon="gmd_bolt"
                            app:iiv_color="@color/icon_yellow"
                            android:layout_marginBottom="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tiền điện" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvElectricAmount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textColor="@color/text_primary"
                            android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:background="@drawable/bg_icon_teal"
                            app:iiv_icon="gmd_opacity"
                            app:iiv_color="@color/icon_teal"
                            android:layout_marginBottom="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tiền nước" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvWaterAmount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textColor="@color/text_primary"
                            android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:background="@drawable/bg_icon_red"
                            app:iiv_icon="gmd_warning"
                            app:iiv_color="@color/icon_red"
                            android:layout_marginBottom="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Chưa thanh toán" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvUnpaidCount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/text_primary"
                            android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>

            <!-- Truy cập nhanh -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Truy cập nhanh"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardInvoice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:iiv_icon="gmd_description"
                            app:iiv_color="@color/purple_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Hóa đơn" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Xem lịch sử" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMaintenance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:iiv_icon="gmd_build"
                            app:iiv_color="@color/purple_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Sửa chữa" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Gửi yêu cầu" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMeter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:iiv_icon="gmd_photo_camera"
                            app:iiv_color="@color/purple_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Công tơ" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Chụp chỉ số" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardChat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <com.mikepenz.iconics.view.IconicsImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            app:iiv_icon="gmd_chat"
                            app:iiv_color="@color/purple_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Chat" android:textColor="@color/text_primary"
                            android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Liên hệ quản lý" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>

            <!-- Nhắc nhở thanh toán -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#EEF2FF">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <com.mikepenz.iconics.view.IconicsImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        app:iiv_icon="gmd_info"
                        app:iiv_color="@color/purple_primary"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Nhắc nhở thanh toán"
                            android:textColor="@color/purple_primary" android:textStyle="bold" android:textSize="14sp"/>
                        <TextView android:id="@+id/tvReminderText"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/purple_primary" android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- ⚠️ NÚT DEBUG - CHỈ DÙNG ĐỂ TEST, NHỚ GỠ TRƯỚC KHI RELEASE -->
            <Button
                android:id="@+id/btnDebugAdvanceMonth"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp"
                android:text="🔧 [DEBUG] Qua tháng mới để test"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="#FF5722"/>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>